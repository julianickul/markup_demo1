section.services#services(aria-labelledby="services-title")
  .container
    .section-head.text-center.animate-on-scroll
      p.section-eyebrow How It Works
      h2.section-title#services-title What are you looking for?
      p.section-text We provide full service at every step of your real estate journey.
    .row.g-4
      .col-6.col-lg-3
        article.service-card.animate-on-scroll
          .service-card__icon(aria-hidden="true")
            i.bi.bi-house-door
          h3 Buy a Home
          p Find homes for sale and get connected with a local agent.
      .col-6.col-lg-3
        article.service-card.animate-on-scroll
          .service-card__icon(aria-hidden="true")
            i.bi.bi-tag
          h3 Sell a Home
          p List your property and reach thousands of serious buyers.
      .col-6.col-lg-3
        article.service-card.animate-on-scroll
          .service-card__icon(aria-hidden="true")
            i.bi.bi-key
          h3 Rent a Home
          p Explore rentals that fit your budget and lifestyle.
      .col-6.col-lg-3
        article.service-card.animate-on-scroll
          .service-card__icon(aria-hidden="true")
            i.bi.bi-buildings
          h3 Property Manage
          p Professional management for owners and investors.

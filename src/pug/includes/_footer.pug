footer.site-footer#footer
  .container
    .row.g-5.site-footer__top
      .col-lg-4.col-md-6
        a.site-footer__brand(href="index.html" aria-label="Houzing home")
          img(src="assets/svg/logo-light.svg" alt="" width="36" height="36")
          span(aria-hidden="true") Houzing
        p.site-footer__about We help people find homes they love — with trusted listings, local experts, and tools that make every step clearer.
        address
          ul.site-footer__contact
            li
              i.bi.bi-geo-alt(aria-hidden="true")
              | 329 Queensberry Street, North Melbourne VIC 3051, Australia.
            li
              i.bi.bi-telephone(aria-hidden="true")
              a(href="tel:+1234567890") +123 456 7890
            li
              i.bi.bi-envelope(aria-hidden="true")
              a(href="mailto:support@houzing.com") support@houzing.com
      .col-6.col-md-3.col-lg-2
        nav(aria-labelledby="footer-discover")
          h3.site-footer__title#footer-discover Discover
          ul.site-footer__links
            li
              a(href="#") Chicago
            li
              a(href="#") Los Angeles
            li
              a(href="#") Miami
            li
              a(href="#") New York
      .col-6.col-md-3.col-lg-2
        nav(aria-labelledby="footer-categories")
          h3.site-footer__title#footer-categories Lists by Category
          ul.site-footer__links
            li
              a(href="#") Apartments
            li
              a(href="#") Condos
            li
              a(href="#") Houses
            li
              a(href="#") Offices
            li
              a(href="#") Retail
            li
              a(href="#") Villas
      .col-md-6.col-lg-2
        nav(aria-labelledby="footer-quick")
          h3.site-footer__title#footer-quick Quick Links
          ul.site-footer__links
            li
              a(href="#about") About Us
            li
              a(href="#") Terms & Conditions
            li
              a(href="#") User’s Guide
            li
              a(href="#") Support Center
            li
              a(href="#") Press Info
            li
              a(href="#cta") Contact Us
      .col-md-6.col-lg-2
        h3.site-footer__title#footer-subscribe Subscribe
        p.site-footer__subscribe-text We don’t send spam so don’t worry.
        .site-footer__social
          a(href="#" aria-label="Facebook")
            i.bi.bi-facebook(aria-hidden="true")
          a(href="#" aria-label="Twitter")
            i.bi.bi-twitter-x(aria-hidden="true")
          a(href="#" aria-label="Instagram")
            i.bi.bi-instagram(aria-hidden="true")
          a(href="#" aria-label="LinkedIn")
            i.bi.bi-linkedin(aria-hidden="true")

  .site-footer__bottom
    .container
      .site-footer__bottom-inner
        p Copyright © 2021 CreativeLayers. All Right Reserved.
        nav(aria-label="Legal")
          ul.site-footer__legal
            li
              a(href="#") Home
            li
              a(href="#") Site Map
            li
              a(href="#") Privacy policy
            li
              a(href="#") Cookie Policy

section.about#about(aria-labelledby="about-title")
  .container
    .row.align-items-center.g-5
      .col-lg-5
        .about__media.animate-on-scroll(data-parallax data-parallax-speed="0.2")
          img(src="assets/img/hero/about.jpg" alt="Homeowner smiling in a bright living room")
          .about__badge
            strong 4.9
            span Customer rating
      .col-lg-7
        .about__content.animate-on-scroll
          p.section-eyebrow About Us
          h2.section-title#about-title Find your dream home with confidence
          p.section-text Houzing connects buyers, renters, and sellers with verified listings and local experts. From first search to closing day, we make every step clear and simple.
          ul.row.g-4.about__stats
            li.col-sm-4
              .about__stat
                .about__stat-icon(aria-hidden="true")
                  i.bi.bi-house-check
                strong 1,500+
                span Property Ready
            li.col-sm-4
              .about__stat
                .about__stat-icon(aria-hidden="true")
                  i.bi.bi-people
                strong 850+
                span Happy Clients
            li.col-sm-4
              .about__stat
                .about__stat-icon(aria-hidden="true")
                  i.bi.bi-award
                strong 320+
                span Expert Agents
          a.btn.btn-outline-primary(href="#featured") Explore Listings
